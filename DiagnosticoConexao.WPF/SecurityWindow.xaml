<Window x:Class="DiagnosticoConexao.WPF.SecurityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Análise de Segurança"
        Height="750"
        Width="1150"
        MinHeight="600"
        MinWidth="900"
        Background="#0F1116"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- CORES -->

        <SolidColorBrush x:Key="CardBrush"
                         Color="#191C23"/>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#272B35"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#E05A9D"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#EB70AD"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#C94788"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F5F5F7"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#9297A3"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#272B35"/>


        <!-- SOMBRA DOS CARDS -->

        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.30"/>


        <!-- BOTÃO 3D ROSA -->

        <Style x:Key="ModernButton"
               TargetType="{x:Type Button}">

            <Setter Property="Background">

                <Setter.Value>

                    <LinearGradientBrush
                        StartPoint="0,0"
                        EndPoint="0,1">

                        <GradientStop
                            Color="#F47DB7"
                            Offset="0"/>

                        <GradientStop
                            Color="#E05A9D"
                            Offset="0.55"/>

                        <GradientStop
                            Color="#B83D79"
                            Offset="1"/>

                    </LinearGradientBrush>

                </Setter.Value>

            </Setter>


            <Setter Property="Foreground"
                    Value="White"/>


            <Setter Property="BorderThickness"
                    Value="1"/>


            <Setter Property="BorderBrush">

                <Setter.Value>

                    <LinearGradientBrush
                        StartPoint="0,0"
                        EndPoint="0,1">

                        <GradientStop
                            Color="#FFB6D8"
                            Offset="0"/>

                        <GradientStop
                            Color="#E05A9D"
                            Offset="0.55"/>

                        <GradientStop
                            Color="#8F2F60"
                            Offset="1"/>

                    </LinearGradientBrush>

                </Setter.Value>

            </Setter>


            <Setter Property="FontSize"
                    Value="13"/>


            <Setter Property="FontWeight"
                    Value="SemiBold"/>


            <Setter Property="Cursor"
                    Value="Hand"/>


            <Setter Property="Padding"
                    Value="18,0"/>


            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                        Color="#000000"
                        BlurRadius="14"
                        ShadowDepth="6"
                        Opacity="0.65"/>

                </Setter.Value>

            </Setter>


            <Setter Property="Template">

            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            Padding="{TemplateBinding Padding}">

                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"/>

                    </Border>

                    <ControlTemplate.Triggers>

                        <!-- MOUSE OVER -->

                        <Trigger Property="IsMouseOver"
                                Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Background">

                                <Setter.Value>

                                    <LinearGradientBrush
                                        StartPoint="0,0"
                                        EndPoint="0,1">

                                        <GradientStop
                                            Color="#FF9BC9"
                                            Offset="0"/>

                                        <GradientStop
                                            Color="#EB70AD"
                                            Offset="0.55"/>

                                        <GradientStop
                                            Color="#C94788"
                                            Offset="1"/>

                                    </LinearGradientBrush>

                                </Setter.Value>

                            </Setter>

                        </Trigger>


                        <!-- PRESSIONADO -->

                        <Trigger Property="IsPressed"
                                Value="True">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.90"/>

                        </Trigger>


                        <!-- DESABILITADO -->

                        <Trigger Property="IsEnabled"
                                Value="False">

                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.40"/>

                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>

        </Setter>

        </Style>


        <!-- CARD -->

        <Style x:Key="CardStyle"
            TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource CardBrush}"/>

            <Setter Property="CornerRadius"
                    Value="18"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource CardBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Effect"
                    Value="{StaticResource CardShadow}"/>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="24"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="24"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- CABEÇALHO -->
        <!-- ================================================= -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="ANÁLISE DE SEGURANÇA"
                    Foreground="{StaticResource TextBrush}"
                    FontSize="30"
                    FontWeight="Bold"/>


                <TextBlock
                    Text="Auditoria dos serviços e portas de rede"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="14"
                    Margin="0,7,0,0"/>

            </StackPanel>


            <!-- BOTÃO -->

            <Button
                x:Name="BtnAnalyze"
                Grid.Column="1"
                Content="Atualizar Análise"
                Width="180"
                Height="46"
                Style="{StaticResource ModernButton}"
                Click="AtualizarAnalise_Click"/>

        </Grid>


        <!-- ================================================= -->
        <!-- RESUMO -->
        <!-- ================================================= -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- SEGUROS -->

            <Border Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <!-- ÍCONE -->

                <Border
                    Width="44"
                    Height="44"
                    CornerRadius="13"
                    Background="#14271F"
                    BorderBrush="#285D47"
                    BorderThickness="1">

                    <TextBlock
                        Text="&#xE72E;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="21"
                        Foreground="#5DD39E"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <!-- TEXTO -->

                <StackPanel
                    Grid.Column="1"
                    Margin="14,0,0,0">

                    <TextBlock
                        Text="SEGUROS"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="TxtSafeCount"
                        Text="--"
                        Foreground="#5DD39E"
                        FontSize="25"
                        FontWeight="Bold"
                        Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


            <!-- INFORMAÇÕES -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            CornerRadius="13"
                            Background="#201D2D"
                            BorderBrush="#443A67"
                            BorderThickness="1">
                        <TextBlock
                            Text="ⓘ"
                            FontSize="21"
                            Foreground="#A992F2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0">
                        <TextBlock Text="INFORMAÇÕES"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtInformationCount"
                                Text="--"
                                Foreground="#A992F2"
                                FontSize="25"
                                FontWeight="Bold"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- ATENÇÃO -->

            <Border Grid.Column="4"
                    Style="{StaticResource CardStyle}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            CornerRadius="13"
                            Background="#2A2116"
                            BorderBrush="#654A27"
                            BorderThickness="1">
                        <TextBlock
                            Text="⚠"
                            FontSize="21"
                            Foreground="#F0B35A"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0">
                        <TextBlock Text="ATENÇÃO"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtAttentionCount"
                                Text="--"
                                Foreground="#F0B35A"
                                FontSize="25"
                                FontWeight="Bold"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CRÍTICOS -->

            <Border Grid.Column="6"
                    Style="{StaticResource CardStyle}"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            CornerRadius="13"
                            Background="#291A25"
                            BorderBrush="#63314D"
                            BorderThickness="1">
                        <TextBlock
                            Text="✕"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="#EB5757"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="14,0,0,0">
                        <TextBlock Text="CRÍTICOS"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"/>

                        <TextBlock x:Name="TxtCriticalCount"
                                Text="--"
                                Foreground="#EB5757"
                                FontSize="25"
                                FontWeight="Bold"
                                Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>


        <!-- ================================================= -->
        <!-- RESULTADOS -->
        <!-- ================================================= -->

        <Border
            Grid.Row="4"
            Style="{StaticResource CardStyle}"
            Padding="24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="18"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TÍTULO -->

                <TextBlock
                    Grid.Row="0"
                    Text="PORTAS E SERVIÇOS DETECTADOS"
                    Foreground="{StaticResource TextBrush}"
                    FontSize="16"
                    FontWeight="Bold"/>


                <!-- TABELA -->

                <ScrollViewer
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">

                    <StackPanel>


                        <!-- CABEÇALHO DA TABELA -->

                        <Border
                            Background="#222630"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="180"/>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="140"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Grid.Column="0"
                                    Text="PORTA"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>


                                <TextBlock
                                    Grid.Column="1"
                                    Text="ENDEREÇO"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>


                                <TextBlock
                                    Grid.Column="2"
                                    Text="PROCESSO"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>


                                <TextBlock
                                    Grid.Column="3"
                                    Text="SEVERIDADE"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>


                                <TextBlock
                                    Grid.Column="4"
                                    Text="ANÁLISE"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                            </Grid>

                        </Border>


                        <!-- RESULTADOS -->

                        <StackPanel
                            x:Name="PortResultsPanel"/>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</Window>