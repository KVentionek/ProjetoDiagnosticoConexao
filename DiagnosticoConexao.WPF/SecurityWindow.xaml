<Window x:Class="DiagnosticoConexao.WPF.SecurityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Análise de Segurança"
        Height="750"
        Width="1150"
        MinHeight="600"
        MinWidth="900"
        Background="#0F1116"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>

        <SolidColorBrush x:Key="CardBrush"
                         Color="#191C23"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#E05A9D"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#EB70AD"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#C94788"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F5F5F7"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#9297A3"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#272B35"/>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.30"/>

        <Style x:Key="ModernButton"
               TargetType="{x:Type Button}">

            <Setter Property="Background"
                    Value="{StaticResource PrimaryBrush}"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryHoverBrush}"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource PrimaryPressedBrush}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="CardStyle"
               TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource CardBrush}"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Effect"
                    Value="{StaticResource CardShadow}"/>

        </Style>

    </Window.Resources>


    <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="24"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="24"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- CABEÇALHO -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="ANÁLISE DE SEGURANÇA"
                    Foreground="{StaticResource TextBrush}"
                    FontSize="30"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Auditoria dos serviços e portas de rede"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="14"
                    Margin="0,7,0,0"/>

            </StackPanel>


            <Button
                x:Name="BtnAnalyze"
                Grid.Column="1"
                Content="Atualizar análise"
                Width="170"
                Height="46"
                Style="{StaticResource ModernButton}"
                Click="AtualizarAnalise_Click"/>

        </Grid>


        <!-- RESUMO -->

        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="18"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>


            <!-- SEGUROS -->

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="SEGUROS"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="TxtSafeCount"
                        Text="--"
                        Foreground="#5DD39E"
                        FontSize="26"
                        FontWeight="Bold"
                        Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- INFORMAÇÕES -->

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}"
                    Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="INFORMAÇÕES"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="TxtInformationCount"
                        Text="--"
                        Foreground="#6FA8DC"
                        FontSize="26"
                        FontWeight="Bold"
                        Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- ATENÇÃO -->

            <Border Grid.Column="4"
                    Style="{StaticResource CardStyle}"
                    Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="ATENÇÃO"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="TxtAttentionCount"
                        Text="--"
                        Foreground="#F0B35A"
                        FontSize="26"
                        FontWeight="Bold"
                        Margin="0,8,0,0"/>

                </StackPanel>

            </Border>


            <!-- CRÍTICOS -->

            <Border Grid.Column="6"
                    Style="{StaticResource CardStyle}"
                    Padding="20">

                <StackPanel>

                    <TextBlock
                        Text="CRÍTICOS"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="12"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        x:Name="TxtCriticalCount"
                        Text="--"
                        Foreground="#EB5757"
                        FontSize="26"
                        FontWeight="Bold"
                        Margin="0,8,0,0"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- RESULTADOS -->

        <Border Grid.Row="4"
                Style="{StaticResource CardStyle}"
                Padding="24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="18"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <TextBlock
                    Grid.Row="0"
                    Text="PORTAS E SERVIÇOS DETECTADOS"
                    Foreground="{StaticResource TextBrush}"
                    FontSize="16"
                    FontWeight="Bold"/>


                <ScrollViewer
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- CABEÇALHO DA LISTA -->

                        <Border
                            Background="#222630"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="180"/>

                                    <ColumnDefinition Width="150"/>

                                    <ColumnDefinition Width="140"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Grid.Column="0"
                                    Text="PORTA"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="ENDEREÇO"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="PROCESSO"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="3"
                                    Text="SEVERIDADE"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="4"
                                    Text="ANÁLISE"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                            </Grid>

                        </Border>


                        <StackPanel
                            x:Name="PortResultsPanel"/>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>

</Window>