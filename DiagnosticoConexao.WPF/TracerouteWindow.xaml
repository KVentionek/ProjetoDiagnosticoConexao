<Window x:Class="DiagnosticoConexao.WPF.TracerouteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Traceroute"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        Background="#0F1116"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- CORES -->

        <SolidColorBrush x:Key="CardBrush"
                         Color="#191C23"/>

        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#E05A9D"/>

        <SolidColorBrush x:Key="PrimaryHoverBrush"
                         Color="#EB70AD"/>

        <SolidColorBrush x:Key="PrimaryPressedBrush"
                         Color="#C94788"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#F5F5F7"/>

        <SolidColorBrush x:Key="SecondaryTextBrush"
                         Color="#9297A3"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#272B35"/>

        <SolidColorBrush x:Key="CardBorderBrush"
                         Color="#272B35"/>


        <!-- SOMBRA -->

        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.30"/>


        <!-- BOTÃO 3D -->

        <Style x:Key="ModernButton"
               TargetType="{x:Type Button}">

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="18,0"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect
                        Color="#000000"
                        BlurRadius="14"
                        ShadowDepth="6"
                        Opacity="0.65"/>

                </Setter.Value>

            </Setter>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type Button}">

                        <Border
                            x:Name="ButtonBorder"
                            CornerRadius="10"
                            BorderThickness="1">

                            <Border.Background>

                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="0,1">

                                    <GradientStop
                                        Color="#F47DB7"
                                        Offset="0"/>

                                    <GradientStop
                                        Color="#E05A9D"
                                        Offset="0.45"/>

                                    <GradientStop
                                        Color="#B83D79"
                                        Offset="1"/>

                                </LinearGradientBrush>

                            </Border.Background>

                            <Border.BorderBrush>

                                <LinearGradientBrush
                                    StartPoint="0,0"
                                    EndPoint="0,1">

                                    <GradientStop
                                        Color="#FFB6D8"
                                        Offset="0"/>

                                    <GradientStop
                                        Color="#E05A9D"
                                        Offset="0.5"/>

                                    <GradientStop
                                        Color="#8F2F60"
                                        Offset="1"/>

                                </LinearGradientBrush>

                            </Border.BorderBrush>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Background">

                                    <Setter.Value>

                                        <LinearGradientBrush
                                            StartPoint="0,0"
                                            EndPoint="0,1">

                                            <GradientStop
                                                Color="#FF9BC9"
                                                Offset="0"/>

                                            <GradientStop
                                                Color="#F27DB5"
                                                Offset="0.45"/>

                                            <GradientStop
                                                Color="#C94885"
                                                Offset="1"/>

                                        </LinearGradientBrush>

                                    </Setter.Value>

                                </Setter>

                            </Trigger>


                            <Trigger
                                Property="IsPressed"
                                Value="True">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="RenderTransform">

                                    <Setter.Value>

                                        <TranslateTransform
                                            Y="2"/>

                                    </Setter.Value>

                                </Setter>

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.90"/>

                            </Trigger>


                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.40"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- CARD -->

        <Style x:Key="CardStyle"
            TargetType="{x:Type Border}">

            <Setter Property="Background"
                    Value="{StaticResource CardBrush}"/>

            <Setter Property="CornerRadius"
                    Value="18"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource CardBorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Effect"
                    Value="{StaticResource CardShadow}"/>

        </Style>


        <!-- TEXTBOX -->

        <Style x:Key="ModernTextBox"
            TargetType="{x:Type TextBox}">

            <Setter Property="Background"
                    Value="#15181E"/>

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="14,0"/>

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="{x:Type TextBox}">

                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">

                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"/>

                        </Border>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0"
                                EndPoint="1,1">
                <GradientStop Color="#080A0F"
                            Offset="0"/>
                <GradientStop Color="#10121A"
                            Offset="0.45"/>
                <GradientStop Color="#160D18"
                            Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="24"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="24"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- CABEÇALHO -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock
                    Text="TRACEROUTE"
                    Foreground="{StaticResource TextBrush}"
                    FontSize="30"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Analise o caminho percorrido até um destino."
                    Foreground="{StaticResource SecondaryTextBrush}"
                    FontSize="14"
                    Margin="0,7,0,0"/>

            </StackPanel>

        </Grid>


        <!-- DESTINO -->

        <Border
            Grid.Row="2"
            Style="{StaticResource CardStyle}"
            Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="18"/>

                    <ColumnDefinition Width="180"/>

                </Grid.ColumnDefinitions>


                <StackPanel
                    Grid.Column="0">

                    <TextBlock
                        Text="DESTINO"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="2,0,0,7"/>

                    <TextBox
                        x:Name="TxtDestination"
                        Style="{StaticResource ModernTextBox}"
                        Text="google.com"/>

                </StackPanel>


                <Button
                    x:Name="BtnTrace"
                    Grid.Column="2"
                    Height="46"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource ModernButton}"
                    Click="ExecutarTraceroute_Click">

                    <StackPanel
                        Orientation="Horizontal">

                        <TextBlock
                            Text="&#xE8C9;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Margin="0,0,8,0"/>

                        <TextBlock
                            Text="Executar traceroute"/>

                    </StackPanel>

                </Button>

            </Grid>

        </Border>


        <!-- RESULTADOS -->

        <Border
            Grid.Row="4"
            Style="{StaticResource CardStyle}"
            Padding="24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="18"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <!-- TÍTULO -->

                <TextBlock
                    Grid.Row="0"
                    Text="CAMINHO ATÉ O DESTINO"
                    Foreground="{StaticResource TextBrush}"
                    FontSize="16"
                    FontWeight="Bold"/>


                <!-- TABELA -->

                <ScrollViewer
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">

                    <StackPanel>

                        <!-- CABEÇALHO -->

                        <Border
                            Background="#222630"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,8">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="150"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock
                                    Grid.Column="0"
                                    Text="SALTO"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="ENDEREÇO IP"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="LATÊNCIA"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    FontWeight="SemiBold"/>

                            </Grid>

                        </Border>


                        <!-- LINHAS -->

                        <StackPanel
                            x:Name="TraceResultsPanel"/>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>

    </Grid>
    </Grid>

</Window>