<Window x:Class="DiagnosticoConexao.WPF.PortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teste de Portas"
        Height="700"
        Width="1100"
        MinHeight="500"
        MinWidth="700"
        Background="#0F1116"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>

        <!-- CORES -->

        <SolidColorBrush x:Key="CardBrush" Color="#191C23"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#272B35"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#272B35"/>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#E05A9D"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#EB70AD"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#C94788"/>

        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9297A3"/>

        <!-- SOMBRAS -->

        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.30"/>

        <DropShadowEffect x:Key="ButtonShadow"
                          Color="#000000"
                          BlurRadius="12"
                          ShadowDepth="3"
                          Opacity="0.35"/>


        <!-- BOTÃO -->

        <Style x:Key="ModernButton"
                TargetType="{x:Type Button}">

                <Setter Property="Foreground"
                        Value="White"/>

                <Setter Property="FontSize"
                        Value="13"/>

                <Setter Property="FontWeight"
                        Value="SemiBold"/>

                <Setter Property="Cursor"
                        Value="Hand"/>

                <Setter Property="Padding"
                        Value="18,0"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

                <Setter Property="Effect"
                        Value="{StaticResource ButtonShadow}"/>

                <Setter Property="Template">

                        <Setter.Value>

                        <ControlTemplate TargetType="{x:Type Button}">

                                <Border x:Name="ButtonBorder"
                                        CornerRadius="9"
                                        Padding="{TemplateBinding Padding}"
                                        BorderThickness="1">

                                <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                        EndPoint="0,1">
                                        <GradientStop Color="#F47DB7"
                                                        Offset="0"/>
                                        <GradientStop Color="#E05A9D"
                                                        Offset="0.5"/>
                                        <GradientStop Color="#B83D79"
                                                        Offset="1"/>
                                        </LinearGradientBrush>
                                </Border.Background>

                                <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0"
                                                        EndPoint="0,1">
                                        <GradientStop Color="#FFB6D8"
                                                        Offset="0"/>
                                        <GradientStop Color="#E05A9D"
                                                        Offset="0.5"/>
                                        <GradientStop Color="#8F2F60"
                                                        Offset="1"/>
                                        </LinearGradientBrush>
                                </Border.BorderBrush>

                                <ContentPresenter
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True"/>

                                </Border>

                                <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver"
                                        Value="True">

                                        <Setter TargetName="ButtonBorder"
                                                Property="Opacity"
                                                Value="0.92"/>

                                </Trigger>

                                <Trigger Property="IsPressed"
                                        Value="True">

                                        <Setter TargetName="ButtonBorder"
                                                Property="Opacity"
                                                Value="0.90"/>

                                </Trigger>

                                <Trigger Property="IsEnabled"
                                        Value="False">

                                        <Setter TargetName="ButtonBorder"
                                                Property="Opacity"
                                                Value="0.40"/>

                                </Trigger>

                                </ControlTemplate.Triggers>

                        </ControlTemplate>

                        </Setter.Value>

                </Setter>

                </Style>


        <!-- CARD -->

        <Style x:Key="CardStyle"
               TargetType="{x:Type Border}">

                <Setter Property="Background"
                        Value="{StaticResource CardBrush}"/>

                <Setter Property="CornerRadius"
                        Value="18"/>

                <Setter Property="BorderBrush"
                        Value="{StaticResource CardBorderBrush}"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

                <Setter Property="Effect"
                        Value="{StaticResource CardShadow}"/>

        </Style>

        <Style x:Key="StatusCardStyle"
        TargetType="{x:Type Border}"
        BasedOn="{StaticResource CardStyle}">

        <Setter Property="Padding"
                Value="20"/>

        </Style>

        <!-- TEXTBOX -->

        <Style x:Key="ModernTextBox"
                TargetType="{x:Type TextBox}">

                <Setter Property="Background"
                        Value="#15181E"/>

                <Setter Property="Foreground"
                        Value="{StaticResource TextBrush}"/>

                <Setter Property="BorderBrush"
                        Value="{StaticResource BorderBrush}"/>

                <Setter Property="BorderThickness"
                        Value="1"/>

                <Setter Property="FontSize"
                        Value="14"/>

                <Setter Property="Padding"
                        Value="14,0"/>

                <Setter Property="Height"
                        Value="46"/>

                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>

                <Setter Property="Template">

                        <Setter.Value>

                        <ControlTemplate TargetType="{x:Type TextBox}">

                                <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                                <ScrollViewer
                                        x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"/>

                                </Border>

                        </ControlTemplate>

                        </Setter.Value>

                </Setter>

                </Style>

    </Window.Resources>


    <!-- CONTEÚDO -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Auto">
        <Grid Margin="30">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="24"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="20"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- CABEÇALHO -->

        <StackPanel Grid.Row="0">

            <TextBlock
                Text="TESTE DE PORTAS"
                Foreground="{StaticResource TextBrush}"
                FontSize="30"
                FontWeight="Bold"/>

            <TextBlock
                Text="Verifique a disponibilidade de uma porta TCP em um destino."
                Foreground="{StaticResource SecondaryTextBrush}"
                FontSize="14"
                Margin="0,7,0,0"/>

        </StackPanel>


        <!-- ENTRADAS -->

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="180"/>

                    <ColumnDefinition Width="20"/>

                    <ColumnDefinition Width="160"/>

                </Grid.ColumnDefinitions>


                <!-- HOST -->

                <StackPanel Grid.Column="0">

                    <TextBlock
                        Text="HOST / DESTINO"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="2,0,0,7"/>

                    <TextBox
                        x:Name="TxtHost"
                        Style="{StaticResource ModernTextBox}"
                        Text="google.com"/>

                </StackPanel>


                <!-- PORTA -->

                <StackPanel Grid.Column="2">

                    <TextBlock
                        Text="PORTA"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Margin="2,0,0,7"/>

                    <TextBox
                        x:Name="TxtPort"
                        Style="{StaticResource ModernTextBox}"
                        Text="443"/>

                </StackPanel>


                <!-- BOTÃO -->

                <Button
                    x:Name="BtnTestPort"
                    Grid.Column="4"
                    Content="Executar teste"
                    Height="46"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource ModernButton}"
                    Click="ExecutarTestePorta_Click"/>

            </Grid>

        </Border>


        <!-- RESULTADO -->

        <Border Grid.Row="4"
                Style="{StaticResource CardStyle}"
                Padding="24">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="15"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>


                <StackPanel Grid.Row="0">

                    <TextBlock
                        Text="RESULTADO"
                        Foreground="{StaticResource TextBrush}"
                        FontSize="16"
                        FontWeight="Bold"/>

                    <TextBlock
                        Text="Informações sobre a conexão TCP."
                        Foreground="{StaticResource SecondaryTextBrush}"
                        FontSize="12"
                        Margin="0,5,0,0"/>

                </StackPanel>


                <Border
                    Grid.Row="2"
                    Background="#15181E"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="22">

                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto">

                        <TextBlock
                            x:Name="TxtPortResult"
                            Text="Informe um host e uma porta para iniciar o teste."
                            Foreground="#D5D7DC"
                            FontFamily="Consolas"
                            FontSize="14"
                            TextWrapping="Wrap"/>

                    </ScrollViewer>

                </Border>

            </Grid>

        </Border>

    </Grid>
    </ScrollViewer>
</Window>